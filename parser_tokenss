import re
import json

import requests
from bs4 import BeautifulSoup

TOKENS_PAGE = "https://etherscan.io/tokens"
ROOT_URL = "https://etherscan.io"

PRICE_RE = re.compile(r"\$\s*([\d.,]+)")


def get_html(source_path=None):
 
    if source_path:
        with open(source_path, "r", encoding="utf-8") as f:
            return f.read()

    resp = requests.get(TOKENS_PAGE, timeout=20)
    resp.raise_for_status()
    return resp.text


def parse_price(text):
    m = PRICE_RE.search(text)
    if not m:
        return None

    number_str = m.group(1).replace(",", "")
    try:
        return float(number_str)
    except ValueError:
        return None


def collect_tokens(html):
    soup = BeautifulSoup(html, "html.parser")
    tokens = []
    seen = set()

    for row in soup.select("table tr"):
        link = row.find("a", href=lambda h: h and "/token/" in h)
        if link is None:
            continue

        name = " ".join(link.stripped_strings)
        href = link.get("href", "")
        if not href:
            continue

        if href.startswith("http"):
            full_url = href
        else:
            full_url = ROOT_URL + href

        row_text = row.get_text(" ", strip=True)
        price = parse_price(row_text)
        if price is None:
            continue

        key = (name, full_url)
        if key in seen:
            continue
        seen.add(key)

        tokens.append({
            "token": name,
            "price_usd": price,
            "url": full_url,
        })

    tokens.sort(key=lambda item: item["price_usd"], reverse=True)
    return tokens


def ask_limit(total):
    answer = input(
        "Сколько токенов вывести и сохранить? "
        "(Enter - все): ".format(total)
    ).strip()

    if not answer:
        return total

    try:
        n = int(answer)
    except ValueError:
        print("Некорректное число, выведу все.")
        return total

    if n <= 0 or n > total:
        return total

    return n


def ask_json_name():
    name = input('Имя JSON-файла (Enter - "tokens.json"): ').strip()
    if not name:
        return "tokens.json"
    return name


def save_json(tokens, filename):

    with open(filename, "w", encoding="utf-8") as f:
        json.dump(tokens, f, ensure_ascii=False, indent=2)


def main():
    print("Парсер токенов с Etherscan\n")
    html_path = input(
        "Имя HTML-файла (Enter - скачать страницу с сайта): "
    ).strip()
    if html_path == "":
        html_path = None

    html = get_html(html_path)
    items = collect_tokens(html)

    if not items:
        print("Не удалось извлечь ни одного токена.")
        return

    print("Найдено записей:", len(items))
    limit = ask_limit(len(items))
    selected = items[:limit]

    json_name = ask_json_name()
    save_json(selected, json_name)
    print('Сохранено {} записей в "{}".'.format(len(selected), json_name))

    print("\nТоп {} токенов:".format(min(5, len(selected))))
    for item in selected[:5]:
        print("- {} — ${}".format(item["token"], item["price_usd"]))


if __name__ == "__main__":
    main()
